# Copy to .env.local in the project root and fill from your own Supabase project.
# These are publishable/browser credentials, never a service_role secret.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# For local preview of GitHub Pages path, keep empty.
NEXT_PUBLIC_BASE_PATH=
