# Copy to .env.local for a local site build. Do not commit .env.local.
# Leave both values empty until you have created the Cloudflare resources.
# Never put the Turnstile secret or the moderation token in this file.
NEXT_PUBLIC_GALLERY_API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Empty for a local preview. GitHub Pages sets /EPYDOG.
NEXT_PUBLIC_BASE_PATH=
